{
  "name": "el-theme-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "extract-rules": "node ../scripts/extract-rules.mjs",
    "check-rules": "node ../scripts/extract-rules.mjs --check",
    "audit:page": "node ../scripts/audit-page.mjs demo/src",
    "audit:page:warn": "node ../scripts/audit-page.mjs demo/src --quiet || true",
    "audit:spec": "node ../scripts/audit-spec.mjs",
    "dev": "npm run extract-rules && vite",
    "build": "npm run extract-rules && vue-tsc && vite build && npm run audit:page:warn",
    "build:ci": "npm run check-rules && vue-tsc && vite build && npm run audit:page:warn",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "element-plus": "^2.9.7",
    "lucide-vue-next": "^0.474.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "sass": "^1.83.4",
    "typescript": "~5.7.3",
    "vite": "^6.2.4",
    "vue-tsc": "^2.2.8"
  }
}
